<mxfile host="app.diagrams.net" agent="Claude Code" version="24.7.0" type="device">
  <diagram id="legend" name="0 - Legenda">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="lg_title" value="Coester - SIM Connect (Gateway) - Diagrama de Atividades" style="text;html=1;fontStyle=1;fontSize=20;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lg_sub" value="nrf54-app/src/main.c + actuator_client.c + my_lbs.c - Zephyr / nRF Connect SDK 3.3.0" style="text;html=1;fontSize=12;fontColor=#666666;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="68" width="700" height="24" as="geometry" />
        </mxCell>

        <mxCell id="lg_main_box" value="Main Thread" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="lg_main_desc" value="Thread principal: sequencia de boot (main()) e o loop infinito que pisca o LED de status. So roda uma vez cada init; depois so o blink." style="text;html=1;fontSize=11;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="320" y="130" width="620" height="50" as="geometry" />
        </mxCell>

        <mxCell id="lg_btrx_box" value="BT RX Thread (host Bluetooth)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lg_btrx_desc" value="Thread do host Zephyr que processa eventos HCI recebidos do controlador: callbacks de conexao (bt_conn_cb), scan (bt_scan / bt_le_scan_cb), leitura/escrita GATT do lado servidor (my_lbs.c) e notificacoes/discovery do lado cliente (actuator_client.c). E onde a maior parte da logica do Gateway roda de fato." style="text;html=1;fontSize=11;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="320" y="200" width="620" height="60" as="geometry" />
        </mxCell>

        <mxCell id="lg_sys_box" value="System Workqueue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lg_sys_desc" value="Thread separada (CONFIG_SYSTEM_WORKQUEUE_STACK_SIZE) usada para trabalho que nao pode rodar direto na BT RX thread: religar advertising com retentativa/backoff, gravar a allow-list em flash (bloqueia), e trocar parametros de conexao (que o controlador rejeita logo apos conectar)." style="text;html=1;fontSize=11;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="320" y="280" width="620" height="60" as="geometry" />
        </mxCell>

        <mxCell id="lg_dec_box" value="Decisao" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="370" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lg_dec_desc" value="Verificacoes de baixo nivel (validacao de tamanho de escrita GATT, etc.) foram dobradas dentro do proprio node de atividade, entre parenteses, em vez de virar um losango a parte - para o diagrama nao virar um mar de losangos triviais." style="text;html=1;fontSize=11;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="320" y="370" width="620" height="55" as="geometry" />
        </mxCell>

        <mxCell id="lg_term_box" value="Inicio / Fim" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;fontColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="130" y="450" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lg_term_desc" value="Circulo preto = inicio de um fluxo (entrada por callback do stack BT/Zephyr, ou main()). 'Fim' aqui normalmente significa 'devolve o controle pra quem chamou' (ex.: volta pro host BT), nao que a thread morre." style="text;html=1;fontSize=11;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="320" y="450" width="620" height="55" as="geometry" />
        </mxCell>

        <mxCell id="lg_note_box" value="Nota / observacao de arquitetura" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;size=14;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="530" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lg_note_desc" value="Caixas com essa dobra no canto sao comentarios extraidos direto do codigo-fonte (racional de design), nao um passo executavel." style="text;html=1;fontSize=11;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="320" y="530" width="620" height="45" as="geometry" />
        </mxCell>

        <mxCell id="lg_pages" value="Paginas (abas la embaixo):&#10;1 - Boot e Inicializacao (main)&#10;2 - Peripheral: advertising e conexao da interface&#10;3 - Central: scan, conexao e discovery de um atuador&#10;4 - Runtime: comandos GATT da interface, relay de dados do atuador, persistencia da allow-list" style="text;html=1;fontSize=12;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="500" height="110" as="geometry" />
        </mxCell>
        <mxCell id="lg_omit" value="Omitidos do diagrama (helpers puros, sem ramo de decisao relevante): slot_index(), find_by_addr(), find_free_slot(), fill_status_rec(), fill_discovery_rec(), set_name_field(), extract_adv_name()/name_extract_cb(), discovery_queue_push()/pop(), discovery_slot_for_new(), discovery_find(). Ficam citados entre parenteses onde chamados." style="text;html=1;fontSize=11;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="560" y="620" width="440" height="110" as="geometry" />
        </mxCell>
        <mxCell id="lg_removed" value="lbs_client.c / lbs_client.h foram removidos do projeto (codigo morto dos Kits B/C aposentados, nao entrava no build) e por isso nao aparecem aqui." style="text;html=1;fontSize=11;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#666666;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="740" width="960" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="page1boot" name="1 - Boot e Inicializacao">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="700" pageHeight="1700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="b_lane" value="Main Thread - main()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="320" height="1620" as="geometry" />
        </mxCell>

        <mxCell id="b1" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="340" y="60" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="dk_leds_init()&lt;br&gt;(err &#8594; LOG_ERR + return -1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="220" y="130" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="bt_enable(NULL)&lt;br&gt;(chamada sincrona - stack pronta ao retornar; err &#8594; LOG_ERR + return -1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="220" y="240" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="bt_conn_cb_register(&amp;connection_callbacks)&lt;br&gt;bt_gatt_cb_register(&amp;gatt_callbacks)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="220" y="360" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b5" value="my_lbs_init(&amp;phone_facing_callbacks)&lt;br&gt;(err &#8594; LOG_ERR + return -1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="220" y="470" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b6" value="actuator_manager_init(&amp;actuator_callbacks)&lt;br&gt;(zera slots[] e discovered[], guarda callbacks; err &#8594; return -1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="220" y="580" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b7" value="settings_subsys_init()&lt;br&gt;(err so loga - allow-list nao sobrevive a reboot, nao e fatal)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="220" y="700" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b8" value="settings_load()&lt;br&gt;para cada entrada gravada, allowlist_settings_set() chama actuator_manager_add() (slot &#8594; WAITING) - ainda sem chamar scan_start()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="220" y="820" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b9" value="scan_init()&lt;br&gt;bt_scan_init() + bt_scan_filter_add(UUID do servico do atuador) + habilita filtro" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="220" y="950" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b10" value="bt_le_scan_cb_register(&amp;scan_recv_callbacks)&lt;br&gt;(callback que ve TODO pacote, sem filtro - ver Pagina 3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="220" y="1070" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b11" value="k_work_init_delayable(&amp;adv_work, adv_work_handler)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="220" y="1190" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b12" value="advertising_start()&lt;br&gt;k_work_schedule(&amp;adv_work, K_NO_WAIT)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="220" y="1300" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b13" value="&#8594; continua na Pagina 2&#10;(adv_work roda na System Workqueue)" style="text;html=1;fontSize=11;fontStyle=2;fontColor=#82b366;align=left;" vertex="1" parent="1">
          <mxGeometry x="540" y="1310" width="240" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b14" value="loop infinito:&lt;br&gt;dk_set_led(RUN_STATUS_LED, blink)&lt;br&gt;k_sleep(1000 ms)&lt;br&gt;(thread Main fica aqui pro resto da execucao)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="220" y="1400" width="280" height="90" as="geometry" />
