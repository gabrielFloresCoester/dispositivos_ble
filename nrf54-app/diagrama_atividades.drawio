        <mxCell id="b5ca" value="sim: phone_conn = NULL&lt;br&gt;my_lbs_set_phone_conn(NULL)&lt;br&gt;dk_set_led_off(CON_STATUS_LED_PHONE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
