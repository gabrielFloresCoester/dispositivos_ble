  <diagram id="page2periph" name="2 - Peripheral (Advertising)">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p_lane_sys" value="System Workqueue - adv_work_handler()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="360" height="1160" as="geometry" />
        </mxCell>
        <mxCell id="p_lane_btrx" value="BT RX Thread - callbacks de conexao (bt_conn_cb)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=13;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="440" y="20" width="700" height="1160" as="geometry" />
        </mxCell>

        <mxCell id="p1" value="advertising_start()&lt;br&gt;chamado do boot (Pag.1), de recycled_cb() (nesta pagina) ou reagendado pelo proprio backoff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="70" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="phone_conn != NULL ?&lt;br&gt;(interface ja conectada?)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="90" y="190" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2end" value="return&lt;br&gt;(sem tentar advertising -&#10;so ha 1 papel Peripheral no controlador,&#10;CONFIG_BT_CTLR_SDC_PERIPHERAL_COUNT=1,&#10;e ja esta ocupado)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="330" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="bt_scan_stop()&lt;br&gt;(controlador recusa reconfigurar endereco aleatorio com o scan ativo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="460" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="bt_le_adv_start(adv_param, ad, sd)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="560" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p5" value="err ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="130" y="650" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p5a" value="-ENOMEM (status HCI 0x0d):&lt;br&gt;log WARN + calcula backoff (300ms..2000ms) + k_work_reschedule(adv_work, delay)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="770" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p5b" value="-EALREADY:&lt;br&gt;log DBG (ja estava advertising - provavelmente reciclagem de ATUADOR, nao da interface)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="220" y="770" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p5c" value="outro erro:&lt;br&gt;log ERR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="770" width="140" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p5d" value="sucesso (0):&lt;br&gt;log INF (advertising iniciado)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="770" width="140" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p6" value="scan_start()&lt;br&gt;bt_scan_start(BT_SCAN_TYPE_SCAN_ACTIVE)&lt;br&gt;(chamado nos 4 casos acima)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="90" y="900" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p6end" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#ffffff;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="205" y="1000" width="30" height="30" as="geometry" />
        </mxCell>

        <mxCell id="b1c" value="on_connected(conn, err)&lt;br&gt;(vem tambem de conexoes com atuadores - ver Pagina 3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="470" y="70" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b2c" value="err != 0 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="510" y="170" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b2cend" value="log ERR&#10;scan_start()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="770" y="185" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="b3c" value="role == PERIPHERAL ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="510" y="290" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b3ca" value="sim: phone_conn = conn&lt;br&gt;my_lbs_set_phone_conn(conn)&lt;br&gt;dk_set_led_on(CON_STATUS_LED_PHONE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="500" y="410" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b3cb" value="nao (CENTRAL):&#10;&#8594; ver Pagina 3&#10;(fluxo do atuador)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="770" y="410" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="b4c" value="on_disconnected(conn, reason)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="470" y="540" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b5c" value="role == PERIPHERAL ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="510" y="630" width="220" height="80" as="geometry" />
